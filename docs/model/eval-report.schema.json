{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standup-pulse.local/schemas/eval-report.schema.json",
  "title": "Standup Pulse local model evaluation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "startedAt",
    "finishedAt",
    "model",
    "thresholds",
    "summary",
    "passed",
    "results"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "model": {
      "type": "object",
      "required": [
        "id",
        "baseUrl",
        "seed",
        "temperature",
        "topP",
        "topK",
        "thinking"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "baseUrl": { "type": "string", "format": "uri" },
        "seed": { "type": "integer" },
        "temperature": { "const": 1 },
        "topP": { "const": 0.95 },
        "topK": { "const": 64 },
        "thinking": { "const": false }
      }
    },
    "thresholds": { "type": "object" },
    "summary": {
      "type": "object",
      "required": [
        "primaryCases",
        "primaryCorrect",
        "primaryToolSelectionRate",
        "multiTurnCases",
        "totalCases",
        "totalCorrect",
        "combinedToolSelectionRate",
        "emittedToolCalls",
        "schemaValidToolCalls",
        "schemaValidityRate",
        "unsafeArgumentCalls",
        "errors"
      ],
      "properties": {
        "primaryCases": { "minimum": 30 },
        "primaryCorrect": { "minimum": 0 },
        "primaryToolSelectionRate": { "minimum": 0, "maximum": 1 },
        "multiTurnCases": { "minimum": 10 },
        "totalCases": { "minimum": 40 },
        "totalCorrect": { "minimum": 0 },
        "combinedToolSelectionRate": { "minimum": 0, "maximum": 1 },
        "emittedToolCalls": { "minimum": 0 },
        "schemaValidToolCalls": { "minimum": 0 },
        "schemaValidityRate": { "minimum": 0, "maximum": 1 },
        "unsafeArgumentCalls": { "minimum": 0 },
        "errors": { "minimum": 0 }
      }
    },
    "passed": { "type": "boolean" },
    "results": {
      "type": "array",
      "minItems": 40,
      "items": {
        "type": "object",
        "required": [
          "id",
          "suite",
          "category",
          "expectedTool",
          "selectedTools",
          "toolSelectionCorrect",
          "emittedToolCalls",
          "schemaValid",
          "safeArguments",
          "latencyMs",
          "usage",
          "timings",
          "error"
        ],
        "properties": {
          "id": { "type": "string" },
          "suite": { "enum": ["primary", "multi-turn"] },
          "category": { "type": "string" },
          "expectedTool": { "type": ["string", "null"] },
          "selectedTools": {
            "type": "array",
            "items": { "type": ["string", "null"] }
          },
          "toolSelectionCorrect": { "type": "boolean" },
          "emittedToolCalls": { "type": "array" },
          "schemaValid": { "type": "boolean" },
          "safeArguments": { "type": "boolean" },
          "latencyMs": { "type": "integer", "minimum": 0 },
          "usage": {},
          "timings": {},
          "error": { "type": ["string", "null"] }
        }
      }
    }
  }
}
