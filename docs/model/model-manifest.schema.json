{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standup-pulse.local/schemas/model-manifest.schema.json",
  "title": "Standup Pulse local model manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordedAt",
    "repository",
    "repositoryRevision",
    "quantization",
    "modelAlias",
    "fileName",
    "bytes",
    "sha256",
    "llamaCppVersion",
    "launch"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordedAt": { "type": "string", "format": "date-time" },
    "repository": { "const": "unsloth/gemma-4-26B-A4B-it-GGUF" },
    "repositoryRevision": { "type": ["string", "null"] },
    "quantization": { "enum": ["UD-Q4_K_M", "UD-Q6_K_XL"] },
    "modelAlias": { "type": "string", "minLength": 1 },
    "fileName": { "type": "string", "pattern": "\\.gguf$" },
    "bytes": { "type": "integer", "minimum": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "llamaCppVersion": { "type": "string", "minLength": 1 },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port",
        "contextSize",
        "parallel",
        "flashAttention",
        "jinja",
        "metrics",
        "temperature",
        "topP",
        "topK",
        "thinking"
      ],
      "properties": {
        "host": { "const": "127.0.0.1" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "contextSize": { "const": 131072 },
        "parallel": { "const": 1 },
        "flashAttention": { "const": true },
        "jinja": { "const": true },
        "metrics": { "const": true },
        "temperature": { "const": 1 },
        "topP": { "const": 0.95 },
        "topK": { "const": 64 },
        "thinking": { "const": false }
      }
    }
  }
}
